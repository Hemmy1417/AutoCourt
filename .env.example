# PostgreSQL (docker compose -f infrastructure/docker/docker-compose.yml up -d)
DATABASE_URL=postgresql://autocourt:autocourt_dev@localhost:5432/autocourt

# Session cookie signing (>= 16 chars; generate your own)
SESSION_SECRET=change-me-to-a-long-random-string

# Evidence file storage root (gitignored)
EVIDENCE_ROOT=var/evidence

# GenLayer Studio Next
GENLAYER_RPC_URL=https://studio-next.genlayer.com/api
# The deployment of record — one address everywhere (S37)
GENLAYER_CONTRACT_ADDRESS=0xE9d81837Ca4af3bdbCE3393556597D308f6aC6a9
# The operator's submitting wallet (never committed)
GENLAYER_OPERATOR_PK=

# Bearer token for the serverless drain route (/api/jobs/drain)
DRAIN_TOKEN=change-me-too

# Worker loop cadence (ms)
WORKER_INTERVAL_MS=15000
