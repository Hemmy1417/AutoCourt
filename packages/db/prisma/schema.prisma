// AutoCourt data model. The DB CACHES; the CHAIN DECIDES: every row that
// mirrors contract state carries the tx hash or manifest root that proves
// it, and the report screens render from the contract views with these
// rows as the index over them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Wallet-based identity: the account IS an address, proven by an EIP-191
// signature at sign-in. Still self-attested (anyone can mint wallets) —
// the contract's same-account rules and VERIFIED-requires-INDEPENDENT
// floor are what make a second wallet worthless, and the docs say so.
model User {
  id            String   @id @default(cuid())
  walletAddress String   @unique // lowercased 0x…
  displayName   String   @default("")
  createdAt     DateTime @default(now())

  vehicles      Vehicle[]
  evidenceItems EvidenceItem[]
  disputes      ClaimDispute[]
  auditEvents   AuditEvent[]
  sessions      Session[]
  buyerAccess   BuyerAccess[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Vehicle {
  id              String   @id @default(cuid())
  vin             String
  vinCheckDigitOk Boolean
  make            String
  model           String
  year            Int
  sellerId        String
  seller          User     @relation(fields: [sellerId], references: [id])
  createdAt       DateTime @default(now())

  claims      VehicleClaim[]
  assessments Assessment[]

  @@index([sellerId])
  @@index([vin])
}

model VehicleClaim {
  id            String  @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle @relation(fields: [vehicleId], references: [id])
  claimId       String // CL-NN, the contract's id inside its assessment
  type          String // ClaimType enum from shared-types
  declaredValue String

  disputes ClaimDispute[]
  findings AssessmentFinding[]

  @@index([vehicleId])
}

// A buyer's disputed-claim flag: the recorded opposing stake the
// corroboration ladder reads. A dispute is a claim, not a fact.
model ClaimDispute {
  id            String       @id @default(cuid())
  claimRowId    String
  claim         VehicleClaim @relation(fields: [claimRowId], references: [id])
  disputerId    String
  disputer      User         @relation(fields: [disputerId], references: [id])
  note          String       @default("")
  afterRuns     Int          @default(0)
  onChainTxHash String? // record_dispute transaction
  createdAt     DateTime     @default(now())

  @@index([claimRowId])
  @@index([disputerId])
}

model Assessment {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  onChainId     String? // ac-NNNNNN once created on-chain
  // Cached from the contract at creation: what the public VIN registry
  // said, read by every validator itself. CONFIRMED | MISMATCH |
  // UNDECODABLE | SOURCE_UNAVAILABLE. The chain copy decides.
  // WHICH contract this record lives on. A redeploy makes a new address
  // the deployment of record, and rows created before it become orphans:
  // the id still resolves, but on a contract that has no history for it.
  // Storing it is what lets the report say that instead of showing an
  // empty page.
  contractAddress String @default("")
  identityStatus String  @default("")
  registryJson   String  @default("{}")
  state         String   @default("DRAFT") // AssessmentState + PROCESSING
  packetVersion Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  evidenceItems EvidenceItem[]
  runs          AdjudicationRun[]
  appeals       Appeal[]
  shareLinks    ShareLink[]
  jobs          Job[]
  buyerAccess   BuyerAccess[]

  // An on-chain id is unique PER CONTRACT, not globally: a redeploy
  // restarts the numbering, so ac-000007 can exist on two deployments as
  // two unrelated records. Making the id alone unique meant a legitimate
  // new record could not be linked at all — the write threw and took the
  // whole drain pass with it.
  @@unique([contractAddress, onChainId])
  @@index([vehicleId])
}

model EvidenceItem {
  id               String     @id @default(cuid())
  assessmentId     String
  assessment       Assessment @relation(fields: [assessmentId], references: [id])
  evidenceId       String // E-…, the contract's id inside its assessment
  uploaderId       String
  uploader         User       @relation(fields: [uploaderId], references: [id])
  uploaderRole     String // SELLER | BUYER
  lane             String     @default("UPLOADED") // EntryLane
  declaredClass    String // EvidenceClass — the uploader's claim, never fact
  declaredLabel    String     @default("")
  mimeType         String // sniffed, never the party-declared one
  fileSha256       String // identity of the original bytes
  textSha256       String // identity of the JUDGED bytes (post-redaction)
  extractorVersion String
  // The uploader's own EIP-191 signature over textSha256. Carried onto
  // the public record so anyone can verify these are the bytes that
  // account signed — the operator cannot substitute a document.
  uploaderSignature String   @default("")
  status           String // ItemStatus
  redactionStatus  String     @default("NONE") // NONE | REDACTED
  phase            String     @default("SUBMISSION") // SUBMISSION | APPEAL
  judgedVersion    Int        @default(0)
  anchorUrl        String?
  captureDate      String     @default("")
  onChainTxHash    String? // submit_evidence_text / submit_anchor_item
  consentedAt      DateTime? // the explicit per-item publicity consent
  createdAt        DateTime   @default(now())

  extraction   EvidenceExtraction?
  observations DiagnosticObservation[]
  findings     AssessmentFinding[]
  auditEvents  AuditEvent[]

  @@unique([assessmentId, evidenceId])
  @@index([uploaderId])
  @@index([fileSha256])
}

model EvidenceExtraction {
  id             String       @id @default(cuid())
  evidenceItemId String       @unique
  evidenceItem   EvidenceItem @relation(fields: [evidenceItemId], references: [id])
  status         String // EXTRACTED | UNAVAILABLE
  normalizedText String       @default("") // post-redaction: the judged bytes
  createdAt      DateTime     @default(now())
}

// Typed observation rows — what the CONTRACT recomputes conflicts from.
// A reading that exists only inside free text is not a row here and can
// never raise a code flag.
model DiagnosticObservation {
  id              String       @id @default(cuid())
  evidenceItemId  String
  evidenceItem    EvidenceItem @relation(fields: [evidenceItemId], references: [id])
  docDate         String // YYYY-MM-DD
  odometerReading Int?
  odometerUnit    String? // MILES | KM
  diagnosticCode  String? // normalized OBD-II, PXXXX shape
  sourceField     String       @default("")

  @@index([evidenceItemId])
}

model InspectionFinding {
  id           String   @id @default(cuid())
  assessmentId String
  component    String
  condition    String
  severity     String // SeverityBand
  notes        String   @default("")
  createdAt    DateTime @default(now())

  @@index([assessmentId])
}

// One panel finding on one (claim, evidence) edge of one run — cached
// from the contract's run record for indexing; the chain copy decides.
model AssessmentFinding {
  id             String          @id @default(cuid())
  runId          String
  run            AdjudicationRun @relation(fields: [runId], references: [id])
  claimRowId     String
  claim          VehicleClaim    @relation(fields: [claimRowId], references: [id])
  evidenceItemId String
  evidenceItem   EvidenceItem    @relation(fields: [evidenceItemId], references: [id])
  status         String // FindingStatus
  severity       String
  quotesJson     String          @default("[]")

  @@index([runId])
  @@index([claimRowId])
}

model AdjudicationRun {
  id            String     @id @default(cuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id])
  runNumber     Int // 0 while the attempt is pending its receipt
  status        String // SUCCESS | REJECTED (consensus refused) | FAILED (transient)
  kind          String // ADJUDICATION | RE_ADJUDICATION
  packetVersion Int
  manifestRoot  String     @default("")
  txHash        String? // ALWAYS kept: REJECTED/FAILED attempts are records too
  // The job whose outcome this row records: one row per job, however many
  // effect passes run. Not the hash — an attempt can fail before it has one.
  jobId         String?    @unique
  errorText     String     @default("")
  reportJson    String     @default("") // the contract's derived report, cached
  createdAt     DateTime   @default(now())

  findings AssessmentFinding[]

  @@unique([assessmentId, runNumber, createdAt])
  @@index([assessmentId])
}

model Appeal {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  appellantId  String
  grounds      String
  runNumber    Int? // the run this appeal produced, once recorded
  txHash       String?
  createdAt    DateTime   @default(now())

  @@index([assessmentId])
}

// Append-only. Per-item chain of custody = the rows keyed by evidenceItemId.
model AuditEvent {
  id             String        @id @default(cuid())
  actorId        String?
  actor          User?         @relation(fields: [actorId], references: [id])
  evidenceItemId String?
  evidenceItem   EvidenceItem? @relation(fields: [evidenceItemId], references: [id])
  kind           String
  detailJson     String        @default("{}")
  createdAt      DateTime      @default(now())

  @@index([evidenceItemId])
  @@index([actorId])
}

// A user who redeemed a share link holds buyer access on that
// assessment. The role is APP-ATTESTED (the trust docs say so): what
// defeats a second-inbox sybil is the contract's same-account and
// VERIFIED-requires-INDEPENDENT rules, never this table.
model BuyerAccess {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  viaLinkId    String
  createdAt    DateTime   @default(now())

  @@unique([assessmentId, userId])
}

model ShareLink {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  tokenHash    String     @unique // the signed token is never stored raw
  state        String     @default("ACTIVE") // ShareLinkState
  expiresAt    DateTime // wall-clock, never activity-counted
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())

  @@index([assessmentId])
}

// The assessment job queue, with a LEASE so a dead invocation cannot
// strand PROCESSING (named mover: apps/worker, or a platform cron hitting
// the drain route in serverless deployments).
model Job {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  kind         String // CREATE | SUBMIT_EVIDENCE | SEAL | ADJUDICATE | READJUDICATE
  payloadJson  String     @default("{}")
  state        String     @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  attempts     Int        @default(0)
  maxAttempts  Int        @default(3)
  lockedUntil  DateTime?
  lastError    String     @default("")
  txHash       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([state, lockedUntil])
  @@index([assessmentId])
}
